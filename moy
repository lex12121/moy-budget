const CACHE = "budget-v1";

const FILES = [
    "./",
    "./index.html",
    "./style.css",
    "./app.js",
    "./manifest.json"
];

self.addEventListener("install", event => {

    event.waitUntil(

        caches.open(CACHE)

            .then(cache => cache.addAll(FILES))

    );

});

self.addEventListener("fetch", event => {

    event.respondWith(

        caches.match(event.request)

            .then(response => response || fetch(event.request))

    );

});
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,Helvetica,sans-serif;
}

body{
    background:#f3f5f9;
    color:#222;
}

.header{
    background:#2e7d32;
    color:white;
    text-align:center;
    padding:22px;
    box-shadow:0 2px 10px rgba(0,0,0,.15);
}

main{
    padding:15px;
}

.card{
    background:white;
    border-radius:18px;
    padding:20px;
    margin-bottom:18px;
    box-shadow:0 5px 18px rgba(0,0,0,.08);
}

.card-title{
    color:#777;
    font-size:17px;
    margin-bottom:10px;
}

.balance{
